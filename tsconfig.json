{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["*.ts", "*.tsx", "reference-plan/src/**/*.ts", "reference-plan/src/**/*.tsx", "exact-reference-plan/src/**/*.ts", "exact-reference-plan/src/**/*.tsx"]
}

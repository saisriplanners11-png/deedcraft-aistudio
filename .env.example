# Server-side only — never bundled into the client (see proxy.mjs / vite.config.ts).
ANTHROPIC_API_KEY=sk-ant-...

# Keep drafting on Anthropic and choose the extraction provider below.
# Set EXTRACTION_PROVIDER=gemini to route document, image and sketch extraction
# through Gemini. Create GEMINI_API_KEY in Google AI Studio; it stays server-side.
EXTRACTION_PROVIDER=anthropic
GEMINI_API_KEY=
# Fast, low-cost reads for classification and straightforward text extraction.
GEMINI_EXTRACT_MODEL=gemini-3.8-flash
# Higher-capability multimodal reads for handwriting, drawings and verification.
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_VERIFY_MODEL=gemini-3.8-flash
# Backwards-compatible fallback when the three settings above are not set.
GEMINI_MODEL=gemini-3.8-flash

# Optional model overrides. Defaults:
#   EXTRACT_MODEL=claude-haiku-4-5   document transcription
#   DRAFT_MODEL=claude-sonnet-4-6    schedule drafting and deed review
# EXTRACT_MODEL=
# DRAFT_MODEL=

# Visual source transcription and independent verification
# Opus is intentionally not used anywhere in this app to keep billing down.
VISION_MODEL=claude-sonnet-4-6
VERIFY_MODEL=claude-sonnet-4-6
